.research_tmp/experiments/benchmarks/scholarqa_multi/corpus/errata_quarantine/
.research_tmp/experiments/benchmarks/scholarqa_multi/kb/embed_cache/
.research_tmp/experiments/benchmarks/scholarqa_multi/kb/*.jsonl
# LitSearch corpus = 1.2GB parquet shards (data artifact, re-downloadable)
.research_tmp/experiments/benchmarks/litsearch/corpus/
kb/views.json.bak_v2
kb/tmp_surfaces.json
.research_tmp/experiments/benchmarks/scholarqa_multi/kb/tmp_surfaces.json

