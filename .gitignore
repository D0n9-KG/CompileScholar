# Research session temp (shared scratch area) — contents ignored EXCEPT the
# active benchmark battlefield (2026-09-20): the answer-stack harness +
# runners are load-bearing for the paper era. Directory-content exclusion
# (star form) is REQUIRED: a plain .research_tmp/ dir rule makes child
# re-inclusion impossible (gitignore spec).
.research_tmp/*
!.research_tmp/experiments/
.research_tmp/experiments/*
!.research_tmp/experiments/benchmarks/
.research_tmp/experiments/benchmarks/**/__pycache__/
.survey_tmp/
.gapscan/
.occ_survey/
.playwright-mcp/

# Runtime/cache + era driver scripts (post-cleanup)
.codex_tmp/
backend/artifacts/
backend/tmp/
frontend/e2e/
frontend/playwright-report/
stage2_evo_off*/
schema_versions/
aggregate_stage2.py
run_stage2*.py
run_ablation_*.py
run_multi_seed.py
run_until_done.sh
test_5papers.py
test_jop2006.py

# Session temp dirs
_arxiv_tmp/
_spar_tmp/
_pasa_tmp/

# Contest archive (deliverables kept on disk, out of active version control)
archive/

# Local agent/skill configs (machine-local, not project code)
.agents/

# CCFA skills working files (idea/writing artifacts; promote finals deliberately)
ccfa-workfiles/

# Multi-108 corpus: version texts (.md) + metadata; never raw PDFs, caches,
# or ledgers (822MB pdfs / 4096-dim embed caches / growing jsonl)
.research_tmp/experiments/benchmarks/scholarqa_multi/corpus/pdfs/
.research_tmp/experiments/benchmarks/scholarqa_multi/corpus/errata_quarantine/
.research_tmp/experiments/benchmarks/scholarqa_multi/kb/embed_cache/
.research_tmp/experiments/benchmarks/scholarqa_multi/kb/*.jsonl
# LitSearch corpus = 1.2GB parquet shards (data artifact, re-downloadable)
.research_tmp/experiments/benchmarks/litsearch/corpus/
kb/views.json.bak_v2
kb/tmp_surfaces.json
