# Copy to .env (never committed). Process environment overrides .env.
# --- local model server (OpenAI-compatible; GPUStack / vLLM) ---
LOCAL_BASE_URL=http://<host>/v1
LOCAL_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-8b-local
# --- judges and baselines ---
